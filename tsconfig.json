{
  "include": ["src/**/*.d.ts", "src/**/*.ts", "test/types/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "allowJs": true,
    "paths": { "src/*": ["./src/*"] }
  }
}
